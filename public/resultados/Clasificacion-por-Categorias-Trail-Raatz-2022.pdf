<link rel="https://api.w.org/" href="https://itapuacross.com.py/wp-json/" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://itapuacross.com.py/xmlrpc.php?rsd" />
<meta name="generator" content="WordPress 6.9.4" />
	<script type="text/javascript">
		jQuery(document).ready(function($)
		{
	  		var searchRequest = null;
	  		$("select[name='categoria']").html('<option value="">Seleccione</option>');


	  		function initCategoria()
	  		{
	  			sexo_usuario = $("select[name='sexo']").val();
				$("select[name='categoria']").find('option').each(function()
				{
						if($(this).val()!='' && $(this).attr('sexo')!='ambos'){
							if($(this).attr('sexo') == sexo_usuario)
							{
								$(this).show(0);
							}else{
								$(this).hide(0);
							}
						}
				});
	  		}
	  		initCategoria();

			$("select[name='sexo']").change(function()
			{
				sexo_usuario = $(this).val();
				$("select[name='categoria']").val("");
				$("select[name='categoria']").find('option').each(function()
				{
					if($(this).val()!='' && $(this).attr('sexo')!='ambos'){
						if($(this).attr('sexo') == sexo_usuario)
						{
							$(this).show(0);
						}else{
							$(this).hide(0);
						}
					}
				});
			});


			/*hacer una llamada ajax al elemento cuando buscamos por DNI */
			$("input[name='numerodecedula']").keyup(function()
			{
				$(".mensaje-ajax").remove();
				numerodecedula = $(this).val();
      			$(this).after('<p class="mensaje-ajax" style="font-size:12px;"><strong>Buscando Existencia de usuario....</strong></p>');
      			//================================
      			var form_data = new FormData();
			    form = $("#form_serializado");
				ajaxurl = 'https://itapuacross.com.py/wp-admin/admin-ajax.php';      
				  //renderizado pasamos al ajax
				form_data.append('action', 'search_numerodecedula');
				form_data.append('numerodecedula',numerodecedula);
				//obtenemos el resultado del html
				/*Veremos si ya existe una peticion en curso*/
				if (searchRequest != null){ 
					searchRequest.abort();
				}
				/*Obtendremos la variable search request para hacer una nueva peticion*/
				searchRequest = jQuery.ajax({
					url: ajaxurl,
					type: 'post',
					contentType: false,
					processData: false,
					data: form_data,
					cache: false,
					success: function (response) {
						if(response=='0')
						{
							$(".mensaje-ajax").remove();
						}else{
							$(".mensaje-ajax").remove();
							data_user = response.split(',');
							/*Rellenamos todos los datos*/
							$("input[name='nombre']").val(data_user[0]);
							$("select[name='sexo']").val(data_user[1]);
							$("input[name='gruposanguineo']").val(data_user[3]);
							$("input[name='numerodecedula']").val(data_user[2]);
							$("input[name='Club']").val(data_user[4]);
							$("input[name='numerodecarnet']").val(data_user[5]);
							$("input[name='fechanacimiento']").val(data_user[6]);
							$("input[name='ciudad']").val(data_user[7]);
							$("input[name='pais']").val(data_user[8]);
							$("input[name='telefono']").val(data_user[9]);
							$("input[name='your-email']").val(data_user[10]);
						}
					},  
					error: function (response) {
					console.log('error or aborted');
					}
				});
      			//================================
			});

		});
	</script>
